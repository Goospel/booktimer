# 브라우저 dev 목 모드 — `npm run dev:mock`(vite --mode mock)이 자동 로드한다. 비밀값이 아니라 커밋한다.
# 서버·토스 SDK 없이 크롬에서 전 화면을 HMR로 돌린다(api.ts가 src/dev-mock.ts로 라우팅).
VITE_DEV_MOCK=1
# 광고 그룹 ID를 비워 리워드 광고 기능을 끈다 — 브라우저엔 광고 SDK가 없어 눌리면 실패만 한다.
# mode 파일이 `.env.local`(개발자 로컬 값)보다 우선하므로 이 값이 이긴다.
VITE_REWARD_AD_GROUP_ID=
VITE_INTERSTITIAL_AD_GROUP_ID=
VITE_PERSONALITY_AD_GROUP_ID=
# 여백 배너 광고도 같은 config-gate — 빈 값이면 지면 자체가 안 생긴다(브라우저엔 배너 SDK가 없다).
# 사람축(내 여백·남의 여백)과 책축(모두의 여백)은 콘솔 리포트를 가르려고 그룹이 따로다.
VITE_MARGIN_BANNER_AD_GROUP_ID=
VITE_BOOK_MARGIN_BANNER_AD_GROUP_ID=
