# 운영 빌드(`npm run build`)가 자동 로드하는 env — 비밀값이 아니라 커밋한다.
# 없으면 vite 기본값으로 조용히 빌드된다: API는 localhost:8080, 광고 그룹 ID는 빈 문자열(광고 OFF). (T-148)
# 로컬 개발은 `.env.local`이 이 파일을 덮는다(git 미추적).
VITE_API_BASE_URL=https://booktimer.app
VITE_REWARD_AD_GROUP_ID=ait.v2.live.b6bbeff2c57e4777
# 전면형(「목표 바꾸기」 진입) — 리워드와 다른 그룹이라 성과·정산이 따로 잡힌다.
VITE_INTERSTITIAL_AD_GROUP_ID=ait.v2.live.32f30171507d4dd1
