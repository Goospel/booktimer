# 운영 빌드(`npm run build`)가 자동 로드하는 env — 비밀값이 아니라 커밋한다.
# 없으면 vite 기본값으로 조용히 빌드된다: API는 localhost:8080, 광고 그룹 ID는 빈 문자열(광고 OFF). (T-148)
# 로컬 개발은 `.env.local`이 이 파일을 덮는다(git 미추적).
VITE_API_BASE_URL=https://booktimer.app
VITE_REWARD_AD_GROUP_ID=ait.v2.live.b6bbeff2c57e4777
# 전면형(「목표 바꾸기」 진입) — 리워드와 다른 그룹이라 성과·정산이 따로 잡힌다.
VITE_INTERSTITIAL_AD_GROUP_ID=ait.v2.live.32f30171507d4dd1
# 리워드(「책 성향 분석」) — 위 「밀린 하루 지우개」와 포맷은 같지만 **다른 그룹**이다.
# 같은 그룹을 쓰면 콘솔 리포트가 지면 단위라 두 지면의 노출·시청·수익이 한 줄로 합산된다.
VITE_PERSONALITY_AD_GROUP_ID=ait.v2.live.75558b51a0444cc7
# 배너(「여백」 두 화면) — 콘솔 그룹명 「내가쓴여백_배너」/「모두의여백_배너」, 배너 종류는 둘 다 「문구 강조」다.
# ⚠️ 「이미지 강조」로 바꾸면 큰 이미지 카드가 와서 96px 컨테이너에 안 맞는다(콘솔만 바꾸면 안 되고 코드도 고쳐야 한다).
# 사람축(MarginView — 「내가 쓴 여백」)
VITE_MARGIN_BANNER_AD_GROUP_ID=ait.v2.live.5a5ce4d4d4654fce
# 책축(BookMarginAllView — 「모두의 여백」 탭). 위와 뒤바뀌어도 화면은 멀쩡해서, 어긋난 건 콘솔 리포트에만 남는다.
VITE_BOOK_MARGIN_BANNER_AD_GROUP_ID=ait.v2.live.673c1d77a6f9451e
