{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -File \".claude\\hooks\\warn-multi-session.ps1\""
          },
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -File \".claude\\hooks\\link-node-modules-on-session-start.ps1\"",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "clear|logout|prompt_input_exit|other",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -File \".claude\\hooks\\cleanup-docker-on-session-end.ps1\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -File \".claude\\hooks\\block-main-push.ps1\""
          },
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -File \".claude\\hooks\\require-tests-before-commit.ps1\"",
            "timeout": 600
          },
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -File \".claude\\hooks\\check-commit-message.ps1\""
          },
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -File \".claude\\hooks\\require-bundle-build.ps1\"",
            "timeout": 600
          },
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -File \".claude\\hooks\\require-css-comment-safe.ps1\""
          },
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -File \".claude\\hooks\\require-troubleshooting-toc.ps1\""
          }
        ]
      }
    ]
  }
}
