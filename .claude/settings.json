{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -File \".claude\\hooks\\warn-multi-session.ps1\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -File \".claude\\hooks\\block-main-push.ps1\""
          },
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -File \".claude\\hooks\\require-tests-before-commit.ps1\"",
            "timeout": 600
          },
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -File \".claude\\hooks\\check-commit-message.ps1\""
          },
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -File \".claude\\hooks\\require-bundle-build.ps1\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
