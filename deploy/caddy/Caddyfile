# BookTimer 리버스프록시 (EC2 단일 인스턴스).
#
# ALB가 하던 두 가지를 그대로 이어받는다:
#   ① 443 TLS 종료 — ACM 대신 Let's Encrypt 자동 발급·갱신(설정 0줄).
#   ② 호스트 정규화 301 — apex(booktimer.app) 외 3개 호스트를 apex로 보낸다.
#
# ⚠️ www.booktimer.app 을 빠뜨리지 말 것 (T-113): 구글이 www를 독립 색인해 검색 유입자가
#    여기로 들어오는데, apex로 정규화되지 않으면 OAuth redirect_uri 불일치 + 세션 쿠키 미전송으로
#    "검색으로 들어온 사람만 로그인 불가"가 된다. ALB 규칙에서 실제로 한 번 터진 사고다.
#
# ⚠️ .click 도메인은 2027-06 만료 예정(자동갱신 OFF)이지만 그때까진 301을 유지한다.
#    컷오버 시 Route53 A레코드를 **4개 호스트 전부** EIP로 옮겨야 인증서가 발급된다.

booktimer.app {
	# blue-green: 두 upstream을 동시에 등록해두고 헬스체크로 살아있는 쪽에만 보낸다.
	# 배포 스크립트가 Caddy 설정을 건드리지 않아도 되는 이유 — 새 컨테이너가 healthy 해지면
	# 자동으로 편입되고, 옛 컨테이너가 사라지면 자동으로 빠진다.
	reverse_proxy app-blue:8080 app-green:8080 {
		# first = 앞쪽 healthy upstream 우선. 라운드로빈이면 전환 중 두 버전에 요청이 섞인다.
		lb_policy first

		# 전체 /actuator/health가 아니라 readiness 그룹을 본다. 전체 health는 mail indicator를
		# 포함해 SES 장애만으로 DOWN이 되고, 그러면 멀쩡한 앱이 라우팅에서 빠져 서비스가
		# 통째로 503이 된다(T-009 계열).
		health_uri /actuator/health/readiness
		health_interval 3s
		health_timeout 2s
		fail_duration 10s

		# 옛 컨테이너를 내리는 순간, 헬스체크가 아직 그 죽음을 모르는 구간이 있다.
		# 그때 들어온 요청을 살아있는 다음 upstream으로 즉시 재시도한다(연결 실패 한정).
		# ⚠️ 실측(로컬 150요청 프로브): 이걸 켜도 stop 순간의 in-flight 요청 1건은 끊긴다 —
		#    이미 서버에 도달한 요청이라 LB가 재시도할 수 없는 종류다. 배포당 최대 1건 수준이며,
		#    0건으로 만들려면 Caddy admin API로 "먼저 빼고 나중에 죽이는" 순서가 필요하다(미채택 — 복잡도).
		lb_try_duration 5s
		lb_try_interval 100ms

		# 앱이 X-Forwarded-Proto=https 를 봐야 한다:
		#   · server.servlet.session.cookie.secure=true — 아니면 로그인 쿠키가 안 실린다
		#   · ForwardedHeaderFilter 가 OAuth redirect_uri 를 동적 생성한다
		# Caddy는 X-Forwarded-{For,Proto,Host} 를 기본 주입하므로 별도 설정이 필요 없다.
		# (trusted_proxies 를 안 켰으므로 클라이언트가 심어 보낸 X-Forwarded-* 는 Caddy가 리셋한다.)

		# ⚠️ 그런데 `Forwarded`(RFC 7239) 는 Caddy가 세팅하지도, 지우지도 않는다 — 들어온 값이
		#    그대로 앱까지 간다. 그리고 Spring 의 ForwardedHeaderFilter 는 이 헤더를
		#    X-Forwarded-* 보다 **우선**한다. 즉 아무나 아래 한 줄로 신원을 위조할 수 있었다:
		#      Forwarded: for=1.2.3.4;host=evil.example;proto=https
		#    · getRemoteAddr() 가 매 요청 달라져 LoginAttemptFilter 의 IP 잠금(5회)이 무력화된다.
		#      앞단에 WAF·rate limit 이 없어 이게 온라인 비밀번호 추측의 유일한 통제다.
		#    · host/proto 까지 실려 OAuth redirect_uri 와 쿠키 secure 판정도 공격자 값이 된다.
		#    Caddy 가 절대 만들지 않는 헤더이므로 통째로 버리는 게 정답이다.
		#    회귀 가드: deploy/tests/test-caddy-forwarded.sh (CI 가 매 PR 에서 돌린다)
		header_up -Forwarded
	}

	encode gzip zstd
	log {
		output stdout
		format console
	}
}

www.booktimer.app, booktimer.click, www.booktimer.click {
	redir https://booktimer.app{uri} permanent
}

# ─── facefit (동거 테넌트) ────────────────────────────────────────────────────
# 이 EC2에는 BookTimer 말고 하나가 더 산다 — 같은 사용자의 다른 미니앱 **facefit**의 API 서버다.
# 자원 몫(mem_limit 320m)·증상별 감별·`docker stop facefit-api`로 facefit만 끄는 법은
# claude-docs/facefit-tenant.md. 설계 단일 출처는 facefit 레포 docs/2026-08-30-server-design.md.
#
# 이 레포가 facefit을 아는 곳은 **이 블록 하나뿐**이다. 컨테이너 정의는 facefit 레포에 있고
# (별개 compose 프로젝트) 배포도 그쪽 워크플로가 한다 — 떼어낼 땐 이 블록만 지우면 된다.
#
# blue-green이 없다(facefit은 컨테이너 1개다). 그래서 upstream도 하나고 health check도 안 건다 —
# 죽으면 502가 나고, 그건 BookTimer가 아니라 facefit 쪽 문제다.
facefit-api.booktimer.app {
	reverse_proxy facefit-api:8080 {
		# 위 booktimer.app 블록과 **같은 이유**로 버린다: Caddy가 세팅하지도 지우지도 않는
		# 헤더라 들어온 값이 그대로 앱까지 간다. facefit은 X-Forwarded-For로 레이트리밋을
		# 세는데(그게 아니면 상한이 전역이 된다), `Forwarded`가 우선하는 설정이 훗날 켜지면
		# 아무나 이 한 줄로 상한을 우회할 수 있다. Caddy가 만들지 않는 헤더는 통째로 버린다.
		header_up -Forwarded
	}

	encode gzip zstd
	log {
		output stdout
		format console
	}
}
