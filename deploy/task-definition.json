{
  "family": "booktimer-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "booktimer",
      "image": "<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/booktimer:latest",
      "essential": true,
      "portMappings": [
        { "containerPort": 8080, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "SPRING_PROFILES_ACTIVE", "value": "prod" },
        { "name": "BOOKTIMER_BASE_URL", "value": "https://booktimer.app" },
        { "name": "SPRING_MAIL_HOST", "value": "email-smtp.ap-northeast-2.amazonaws.com" },
        { "name": "SPRING_MAIL_PORT", "value": "587" },
        { "name": "BOOKTIMER_EMAIL_ENABLED", "value": "true" },
        { "name": "GA_MEASUREMENT_ID", "value": "G-JFVDPJ036E" },
        { "name": "BOOKTIMER_COUPANG_PARTNER_ENABLED", "value": "false" }
      ],
      "secrets": [
        { "name": "SPRING_DATASOURCE_URL", "valueFrom": "arn:aws:ssm:<REGION>:<ACCOUNT_ID>:parameter/booktimer/SPRING_DATASOURCE_URL" },
        { "name": "SPRING_DATASOURCE_USERNAME", "valueFrom": "arn:aws:ssm:<REGION>:<ACCOUNT_ID>:parameter/booktimer/SPRING_DATASOURCE_USERNAME" },
        { "name": "SPRING_DATASOURCE_PASSWORD", "valueFrom": "arn:aws:ssm:<REGION>:<ACCOUNT_ID>:parameter/booktimer/SPRING_DATASOURCE_PASSWORD" },
        { "name": "GOOGLE_CLIENT_ID", "valueFrom": "arn:aws:ssm:<REGION>:<ACCOUNT_ID>:parameter/booktimer/GOOGLE_CLIENT_ID" },
        { "name": "GOOGLE_CLIENT_SECRET", "valueFrom": "arn:aws:ssm:<REGION>:<ACCOUNT_ID>:parameter/booktimer/GOOGLE_CLIENT_SECRET" },
        { "name": "BOOKTIMER_ALADIN_TTB_KEY", "valueFrom": "arn:aws:ssm:<REGION>:<ACCOUNT_ID>:parameter/booktimer/ALADIN_TTB_KEY" },
        { "name": "BOOKTIMER_COUPANG_SEARCH_URL_TEMPLATE", "valueFrom": "arn:aws:ssm:<REGION>:<ACCOUNT_ID>:parameter/booktimer/COUPANG_SEARCH_URL_TEMPLATE" },
        { "name": "BOOKTIMER_YES24_TRACKING_CODE", "valueFrom": "arn:aws:ssm:<REGION>:<ACCOUNT_ID>:parameter/booktimer/YES24_TRACKING_CODE" },
        { "name": "BOOKTIMER_YES24_SEARCH_URL_TEMPLATE", "valueFrom": "arn:aws:ssm:<REGION>:<ACCOUNT_ID>:parameter/booktimer/YES24_SEARCH_URL_TEMPLATE" },
        { "name": "BOOKTIMER_KYOBO_TRACKING_CODE", "valueFrom": "arn:aws:ssm:<REGION>:<ACCOUNT_ID>:parameter/booktimer/KYOBO_TRACKING_CODE" },
        { "name": "BOOKTIMER_KYOBO_SEARCH_URL_TEMPLATE", "valueFrom": "arn:aws:ssm:<REGION>:<ACCOUNT_ID>:parameter/booktimer/KYOBO_SEARCH_URL_TEMPLATE" },
        { "name": "BOOKTIMER_ADMIN_LOGIN_IDS", "valueFrom": "arn:aws:ssm:<REGION>:<ACCOUNT_ID>:parameter/booktimer/ADMIN_LOGIN_IDS" },
        { "name": "BOOKTIMER_LLM_API_KEY", "valueFrom": "arn:aws:ssm:<REGION>:<ACCOUNT_ID>:parameter/booktimer/LLM_API_KEY" },
        { "name": "SPRING_MAIL_USERNAME", "valueFrom": "arn:aws:ssm:<REGION>:<ACCOUNT_ID>:parameter/booktimer/SPRING_MAIL_USERNAME" },
        { "name": "SPRING_MAIL_PASSWORD", "valueFrom": "arn:aws:ssm:<REGION>:<ACCOUNT_ID>:parameter/booktimer/SPRING_MAIL_PASSWORD" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/booktimer",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
